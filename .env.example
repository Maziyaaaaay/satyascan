# Copy this file to .env and fill in real values as they become available.
# Every value below is OPTIONAL. With nothing set, SatyaScan runs entirely on
# deterministic mock providers - no external accounts needed for local dev/testing.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-dev-secret-not-for-production

# --- Database ---
# SQLite by default. Swap for a Postgres URL later (schema is Postgres-compatible)
# e.g. postgresql+asyncpg://user:pass@host:5432/satyascan
DATABASE_URL=sqlite+aiosqlite:///./data/satyascan.db

# --- Field encryption (phone numbers at rest) ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Vector store ---
CHROMA_PERSIST_DIR=./data/chroma

# --- LLM providers (Gemini primary, OpenAI fallback) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Google Fact Check Tools API ---
GOOGLE_FACT_CHECK_API_KEY=

# --- Google Cloud Vision (reverse image search + OCR) ---
GOOGLE_CLOUD_VISION_API_KEY=

# --- Google Cloud Translation ---
GOOGLE_TRANSLATE_API_KEY=

# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Privacy / retention ---
# Days to retain a truncated message excerpt when a user has given consent.
# 0 (default) = never store any excerpt, only a content hash - matches the
# "no permanent message storage by default" principle.
MESSAGE_RETENTION_DAYS=0

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=10
